# Server Configuration
PORT=3000
# Required in production. Generate a long random string.
JWT_SECRET=your_jwt_secret_key_here
# Comma-separated origins, or * for all (dev only). Unset in production defaults to same-origin.
# CORS_ORIGIN=http://localhost:5173
# NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/database.sqlite

# WeChat Performance & Resource Limits
WECHAT_MAX_CONCURRENT=2
WECHAT_SHARP_THREADS=1
WECHAT_FFMPEG_THREADS=1